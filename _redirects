# ==========================================
# Cloudflare Pages Edge Routing Rules
# ==========================================

# Serve the dedicated AI landing page on the .ai apex domain.
https://dispelmagic.ai/ /ai-landing.html 200

# 1. Route curl / script fetching requests to install.sh
/install.sh 200

# 2. Canonicalize www.dispelmagic.ai to apex .ai
https://www.dispelmagic.ai/* https://dispelmagic.ai/:splat 301

# 3. Canonicalize www.dispelmagic.sh to apex .sh
https://www.dispelmagic.sh/* https://dispelmagic.sh/:splat 301
